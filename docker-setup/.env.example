# Copy thành .env (không commit .env) rồi đổi giá trị trước khi chạy docker compose up

# PostgreSQL (user_service, inventory_service, matching_service)
POSTGRES_DB=larder
POSTGRES_USER=larder_app
POSTGRES_PASSWORD=changeme

# MongoDB (recipe_service)
MONGO_ROOT_USER=larder_app
MONGO_ROOT_PASSWORD=changeme
MONGO_DB=recipe_matcher_db

# RAG Service — Gemini qua endpoint tương thích OpenAI (specs/rag-service.md mục 3.5).
# Lấy free tier tại https://aistudio.google.com/apikey
# LƯU Ý: file .env này chỉ được docker compose đọc cho Postgres/Mongo — RAG Service chạy qua
# mvnw (chưa containerize) cần export biến này vào shell riêng trước khi chạy.
GEMINI_API_KEY=changeme

# RAG Service — nhà cung cấp LLM: "gemini" (mặc định), "groq" hoặc "openai".
# Chỉ cần điền khóa của nhà cung cấp đang chọn.
#   groq   — free tier, lấy tại https://console.groq.com (không có model thị giác/embedding)
#   openai — https://platform.openai.com/api-keys ; phải nạp credit mới gọi được, kể cả khi đã
#            bật chia sẻ dữ liệu để nhận token miễn phí hằng ngày. Một khóa dùng được cho cả
#            chat, thị giác (mục 7) và embedding (RAG giai đoạn B).
LLM_PROVIDER=gemini
GROQ_API_KEY=changeme
OPENAI_API_KEY=changeme

# User Service — CAPTCHA (Cloudflare Turnstile) cho /auth/login sau 3 lần sai liên tiếp.
# Có default là site/secret key TEST chính thức của Cloudflare (luôn pass) nên KHÔNG bắt buộc
# điền để chạy dev — chỉ cần key thật khi deploy công khai. Lấy tại
# https://dash.cloudflare.com/?to=/:account/turnstile
# LƯU Ý: file .env này chỉ được docker compose đọc — User Service chạy qua mvnw cần export
# biến vào shell riêng, giống GEMINI_API_KEY ở trên.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Site key (public, dùng ở frontend) — cặp với secret key TEST ở trên, luôn hiện widget "pass".
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

