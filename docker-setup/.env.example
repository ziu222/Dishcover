# Copy thành .env (không commit .env) rồi đổi giá trị trước khi chạy docker compose up

# PostgreSQL (user_service, inventory_service, matching_service, payment_service)
POSTGRES_DB=larder
POSTGRES_USER=larder_app
POSTGRES_PASSWORD=changeme

# MongoDB (recipe_service)
MONGO_ROOT_USER=larder_app
MONGO_ROOT_PASSWORD=changeme
MONGO_DB=recipe_matcher_db

# RAG Service — Gemini qua endpoint tương thích OpenAI (specs/rag-service.md mục 3.5).
# Lấy free tier tại https://aistudio.google.com/apikey
# LƯU Ý: file .env này chỉ được docker compose đọc cho Postgres/Mongo — RAG Service chạy qua
# mvnw (chưa containerize) cần export biến này vào shell riêng trước khi chạy.
GEMINI_API_KEY=changeme

# RAG Service — nhà cung cấp LLM: "gemini" (mặc định) hoặc "groq". GROQ_API_KEY chỉ cần khi
# LLM_PROVIDER=groq; lấy free tier tại https://console.groq.com
LLM_PROVIDER=gemini
GROQ_API_KEY=changeme

# Payment Service — VNPay sandbox. Đăng ký merchant test tại
# https://sandbox.vnpayment.vn/devreg/ ; VNPay gửi tmn-code + hash-secret qua email.
# CẢNH BÁO: VNPAY_HASH_SECRET là secret THẬT (khác MoMo sandbox dùng chung công khai) — chỉ điền
# giá trị thật vào .env (đã gitignore), TUYỆT ĐỐI không commit lên Git.
VNPAY_TMN_CODE=changeme
VNPAY_HASH_SECRET=changeme
# Nơi trình duyệt quay về sau thanh toán (màn hình kết quả phía frontend).
VNPAY_RETURN_URL=http://localhost:5173/payment/result
