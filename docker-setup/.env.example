# Copy thành .env (không commit .env) rồi đổi giá trị trước khi chạy docker compose up

# PostgreSQL (user_service, inventory_service, matching_service, payment_service)
POSTGRES_DB=larder
POSTGRES_USER=larder_app
POSTGRES_PASSWORD=changeme

# MongoDB (recipe_service)
MONGO_ROOT_USER=larder_app
MONGO_ROOT_PASSWORD=changeme
MONGO_DB=recipe_matcher_db

# RAG Service — Gemini qua endpoint tương thích OpenAI (specs/rag-service.md mục 3.5).
# Lấy free tier tại https://aistudio.google.com/apikey
# LƯU Ý: file .env này chỉ được docker compose đọc cho Postgres/Mongo — RAG Service chạy qua
# mvnw (chưa containerize) cần export biến này vào shell riêng trước khi chạy.
GEMINI_API_KEY=changeme
