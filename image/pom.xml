<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.dishcover</groupId>
    <artifactId>leftover-recipe-matcher</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>image</artifactId>
  <packaging>jar</packaging>
  <name>image</name>
  <description>Image Recognition Service (AI #2) — stateless, nhận diện nguyên liệu qua Vision API đa phương thức (CLAUDE.md mục 7), human-in-the-loop (không tự ghi DB).</description>

  <dependencyManagement>
    <dependencies>
      <!-- Cùng phiên bản ghim với rag/pom.xml — Spring AI 2.0.x yêu cầu Spring Boot 4.x, xung đột
           bean thật với Boot 3.5.3 của dự án (đã verify lúc làm RAG Service). -->
      <dependency>
        <groupId>org.springframework.ai</groupId>
        <artifactId>spring-ai-bom</artifactId>
        <version>1.1.8</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>com.dishcover</groupId>
      <artifactId>common</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <!-- AspectJ weaver cho aspect @CircuitBreaker/@TimeLimiter của Resilience4j. BẮT BUỘC khai báo
         tường minh: service này KHÔNG dùng JPA nên không kéo aspectjweaver transitively như Matching
         Service — thiếu nó thì annotation resilience trên ResilientVisionCaller lặng lẽ no-op. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-aop</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <!-- OpenAPI/Swagger UI: trang tài liệu API tương tác tại /swagger-ui.html -->
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
      <version>2.8.9</version>
    </dependency>
    <!-- Circuit breaker cho lời gọi Vision API (CLAUDE.md mục 7 "Fallback bắt buộc").
         Ghim 2.2.0 — 2.3.0+ có bug NoClassDefFoundError lúc khởi động (resilience4j/resilience4j#2265),
         đã gặp thật lúc làm Matching Service. -->
    <dependency>
      <groupId>io.github.resilience4j</groupId>
      <artifactId>resilience4j-spring-boot3</artifactId>
      <version>2.2.0</version>
    </dependency>
    <!-- Vision: dùng lại OpenAI (gpt-4o-mini nhận ảnh trực tiếp) — cùng lý do OpenAiProvider của
         RAG Service được thêm (rag/llm/OpenAiProvider.java): 1 khóa OPENAI_API_KEY phủ cả chat lẫn
         thị giác, không cần model riêng cho Image Service. -->
    <dependency>
      <groupId>org.springframework.ai</groupId>
      <artifactId>spring-ai-starter-model-openai</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
